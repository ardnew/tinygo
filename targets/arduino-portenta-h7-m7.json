{
  "inherits": [
    "cortex-m"
  ],
  "llvm-target":
    "armv7em-none-eabi",
  "cpu":
    "cortex-m7",
  "cflags": [
    "--target=armv7em-none-eabi",
    "-mcpu=cortex-m7",
    "-mfloat-abi=softfp"
  ],
  "build-tags": [
    "portenta_h7",
    "stm32h7x7_cm7",
    "stm32h7x7",
    "stm32h7",
    "stm32"
  ],
  "linkerscript":
    "targets/arduino-portenta-h7-m7.ld",
  "extra-files": [
    "src/device/stm32/stm32h7x7_cm7.s"
  ],
  "flash-command":
    "dfu-util --wait --device=0x2341:0x035B --alt=0 --download={bin} --dfuse-address=0x08040000:leave"
}
